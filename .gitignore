.DS_Store
Thumbs.db
ehthumbs.db
desktop.ini
.vscode/
.idea/
*.sublime-project
*.sublime-workspace

# Cache y entornos locales
.cache/
.parcel-cache/
dist/
.env
.env.local
.env.*.local
